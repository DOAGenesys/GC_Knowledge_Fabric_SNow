# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (provisioned by the Vercel Neon integration).
DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require

# Random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSION_SECRET=<RANDOM_SESSION_SECRET>
# Changing this key makes saved credentials unreadable (users are asked to enter them again).
APP_ENCRYPTION_KEY=<RANDOM_ENCRYPTION_KEY>

# Sent by Vercel Schedules as "Authorization: Bearer <CRON_SECRET>" (16+ characters).
CRON_SECRET=<RANDOM_CRON_SECRET>

# Optional: debug | info | warn | error | silent (default: info in production, debug in development).
LOG_LEVEL=info

# Optional: json | pretty (default: json on Vercel, pretty locally).
LOG_FORMAT=

# Optional: comma-separated Genesys Cloud organization IDs allowed to sign in. Empty = any org.
APP_ALLOWED_ORG_IDS=

# Optional: prefill the sign-in form.
NEXT_PUBLIC_DEFAULT_GENESYS_REGION=mypurecloud.de
NEXT_PUBLIC_DEFAULT_GENESYS_CLIENT_ID=

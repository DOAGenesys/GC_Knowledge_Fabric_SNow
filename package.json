{
  "name": "gc-knowledge-fabric-snow",
  "version": "1.0.0",
  "private": true,
  "description": "Sync ServiceNow knowledge bases (CSM and ITSM) to Genesys Cloud Knowledge Fabric File Upload sources.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.mts",
    "verify": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "node-html-markdown": "2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "workflow": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@workflow/vitest": "5.0.9",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "zod@<4.6.6": "4.6.7",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
